<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentcourseregistrationsystem.controller.ChartsController" stylesheets="@style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <Label text="Student Course Registration Statistics" styleClass="label-title">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <TabPane VBox.vgrow="ALWAYS" styleClass="tab-pane">
        <tabs>
            <Tab text="Bar Chart" closable="false">
                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="Number of Courses per Student" styleClass="section-title">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>
                    <BarChart fx:id="barChart" VBox.vgrow="ALWAYS" styleClass="chart">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis" label="Students" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" label="Number of Courses" />
                        </yAxis>
                    </BarChart>
                </VBox>
            </Tab>
            
            <Tab text="Pie Chart" closable="false">
                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="Course Distribution Among Students" styleClass="section-title">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>
                    <PieChart fx:id="pieChart" VBox.vgrow="ALWAYS" styleClass="chart" />
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleRefreshButton" text="Refresh Data" styleClass="button" />
        <Button onAction="#handleBackButton" text="Back to Dashboard" styleClass="button" />
    </HBox>

    <Label fx:id="messageLabel" textFill="BLUE" styleClass="label-message" />
</VBox>

