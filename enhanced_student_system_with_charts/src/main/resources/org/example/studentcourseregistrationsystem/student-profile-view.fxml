<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentcourseregistrationsystem.controller.StudentProfileController" stylesheets="@style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Student Profile" styleClass="label-title">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <GridPane hgap="10.0" vgap="10.0" styleClass="grid-pane">
        <Label text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="studentIdLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="label" />

        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="text-field" />

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="text-field" />

        <Label text="Phone Number:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="phoneNumberField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="text-field" />

        <Label text="Program:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="programField" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="text-field" />

        <Label text="Semester:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="semesterField" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="text-field" />
    </GridPane>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleSaveButton" text="Save Changes" styleClass="button" />
        <Button onAction="#handleBackButton" text="Back to Dashboard" styleClass="button" />
    </HBox>

    <Label fx:id="messageLabel" textFill="GREEN" styleClass="label-message" />
</VBox>