<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentcourseregistrationsystem.controller.RegisterCourseController" stylesheets="@style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Register for Courses" styleClass="label-title">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <!-- Add New Course Section -->
    <VBox alignment="CENTER" spacing="10.0" styleClass="add-course-section">
        <Label text="Add New Course" styleClass="section-title">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
            <Label text="Course ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="courseIdField" promptText="Enter Course ID" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="text-field" />
            
            <Label text="Course Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="courseNameField" promptText="Enter Course Name" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="text-field" />
            
            <Label text="Credit Hours:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="creditHoursField" promptText="Enter Credit Hours" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="text-field" />
        </GridPane>
        <Button onAction="#handleAddCourseButton" text="Add Course" styleClass="button" />
    </VBox>

    <!-- Available Courses Section -->
    <Label text="Available Courses" styleClass="section-title">
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <TableView fx:id="availableCoursesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn text="Course ID" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="courseId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Course Name" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="name" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Credit Hours" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="creditHours" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleRegisterButton" text="Register Selected Courses" styleClass="button" />
        <Button onAction="#handleBackButton" text="Back to Dashboard" styleClass="button" />
    </HBox>

    <Label fx:id="messageLabel" textFill="BLUE" styleClass="label-message" />
</VBox>