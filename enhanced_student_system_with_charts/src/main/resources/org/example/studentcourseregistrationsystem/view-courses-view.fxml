<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentcourseregistrationsystem.controller.ViewCoursesController" stylesheets="@style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="My Registered Courses" styleClass="label-title">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <TableView fx:id="registeredCoursesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn text="Course ID" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="courseId" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Course Name" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="name" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Credit Hours" styleClass="table-column">
                <cellValueFactory>
                    <PropertyValueFactory property="creditHours" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleDeleteButton" text="Delete Selected Course" styleClass="button" />
        <Button onAction="#handleBackButton" text="Back to Dashboard" styleClass="button" />
    </HBox>

    <Label fx:id="messageLabel" textFill="RED" styleClass="label-message" />
</VBox>